---
import Base from '../layouts/Base.astro';
import logo from '../assets/nav-logo.svg';
import { site } from '../data/site';
---

<Base title={`Page not found · ${site.name}`}>
  <main class="mx-auto flex min-h-dvh max-w-md flex-col items-center justify-center px-6 text-center">
    <img src={logo.src} alt="" width="72" height="72" class="size-18" />
    <p class="mt-8 font-mono text-sm text-accent">404</p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight">This page doesn't exist (yet).</h1>
    <p class="mt-3 text-muted">Whatever you were looking for, it's probably on the home page.</p>
    <a
      href="/"
      class="mt-8 rounded-lg border border-accent/40 px-4 py-2 text-sm text-accent transition-colors hover:bg-accent hover:text-bg"
    >
      ← Back home
    </a>
  </main>
</Base>
