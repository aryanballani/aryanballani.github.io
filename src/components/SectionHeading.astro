---
interface Props {
  title: string;
  id: string;
}

const { title, id } = Astro.props;
---

<div class="mb-10 flex items-center gap-4">
  <h2 id={`${id}-heading`} class="font-mono text-sm font-medium tracking-wide text-accent">{title}</h2>
  <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
  <slot />
</div>
