---
import { Icon } from 'astro-icon/components';
import { isExternal, site, socials } from '../data/site';
---

<footer class="mx-auto max-w-3xl px-5 pt-16 pb-12 sm:px-6">
  <div class="rounded-2xl border border-border bg-surface px-6 py-8 text-center sm:px-10">
    <p class="text-lg font-medium">Let's build something.</p>
    <p class="mt-1.5 text-sm text-muted">
      The fastest way to reach me is <a href={`mailto:${site.email}`} class="link-underline">{site.email}</a>.
    </p>
  </div>

  <div class="mt-10 flex flex-col-reverse items-center justify-between gap-4 font-mono text-xs text-muted sm:flex-row">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <ul class="flex items-center gap-4">
      {
        socials.map((s) => (
          <li>
            <a
              href={s.href}
              target={isExternal(s.href) ? '_blank' : undefined}
              rel={isExternal(s.href) ? 'noopener' : undefined}
              class="flex items-center gap-1.5 transition-colors hover:text-accent"
            >
              <Icon name={s.icon} class="size-3.5" />
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
