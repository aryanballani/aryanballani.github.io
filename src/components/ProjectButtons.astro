---
// Demo / Code buttons shared by project cards and the "More projects" list.
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';

interface Props {
  project: CollectionEntry<'projects'>;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const { title, demo, demoLabel, repo } = project.data;
const demoIcons: Record<string, string> = { Report: 'lucide:file-text', Slides: 'lucide:presentation' };
const buttons = [
  demo && { label: demoLabel, href: demo, icon: demoIcons[demoLabel] ?? 'lucide:play' },
  repo && { label: 'Code', href: repo, icon: 'simple-icons:github' },
].filter((b) => !!b);
---

{
  buttons.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {buttons.map((b) => (
        <a
          href={b.href}
          target="_blank"
          rel="noopener"
          aria-label={`${title}: ${b.label}`}
          class:list={[
            'flex items-center gap-1.5 rounded-lg border border-border text-muted transition-colors hover:border-accent/50 hover:bg-accent-soft hover:text-accent',
            compact ? 'px-2 py-1 text-xs' : 'px-3 py-1.5 text-sm',
          ]}
        >
          <Icon name={b.icon} class={compact ? 'size-3' : 'size-3.5'} />
          {b.label}
        </a>
      ))}
    </div>
  )
}
