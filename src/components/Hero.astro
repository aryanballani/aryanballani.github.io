---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import AgeTicker from './AgeTicker.astro';
import Dialog from './Dialog.astro';
import profile from '../assets/profile.jpg';
import { isExternal, resumes, site, socials } from '../data/site';

const facts = [
  { icon: 'lucide:map-pin', text: 'Vancouver, BC, Canada' },
  { icon: 'lucide:graduation-cap', text: "BSc Comp Sci + Stats, UBC '26" },
  { icon: 'lucide:briefcase', text: 'ML Engineer @ Railtown AI' },
  { icon: 'lucide:box', text: "3x3 Rubik's cube PB: 28sec 😪" },
];
---

<section id="about" class="relative pt-14 pb-8 sm:pt-20">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-24 left-1/2 -z-10 h-72 w-[42rem] max-w-[100vw] -translate-x-1/2 rounded-full bg-[radial-gradient(closest-side,var(--glow),transparent)]"
  >
  </div>

  <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:gap-10">
    <Image
      src={profile}
      alt="Aryan Ballani"
      width={240}
      height={240}
      loading="eager"
      class="size-28 shrink-0 rounded-full object-cover ring-2 ring-accent/70 ring-offset-4 ring-offset-bg sm:size-32"
    />

    <div class="min-w-0">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{site.name}</h1>
      <p class="mt-3 max-w-xl text-lg leading-relaxed text-muted">
        Machine Learning Engineer at Railtown AI. I build agent
        frameworks, RAG systems and the occasional robot shopping cart.
      </p>
      <p class="mt-4 inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent-soft px-3 py-1 text-sm">
        <span class="size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
        Open to full-time roles across Canada · ML, data &amp; software
      </p>

      <ul class="mt-6 space-y-1.5 font-mono text-sm text-muted">
        {
          facts.map((f) => (
            <li class="flex items-center gap-2.5">
              <Icon name={f.icon} class="size-4 shrink-0 text-accent" />
              {f.text}
            </li>
          ))
        }
        <li class="flex items-center gap-2.5">
          <Icon name="lucide:chart-no-axes-column" class="size-4 shrink-0 text-accent" />
          <span><AgeTicker /> years old</span>
        </li>
        <li class="pl-6.5 text-xs text-muted">☝️ Click above</li>
      </ul>

      <ul class="mt-7 flex flex-wrap items-center gap-x-1 gap-y-1">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target={isExternal(s.href) ? '_blank' : undefined}
                rel={isExternal(s.href) ? 'noopener' : undefined}
                class="flex items-center gap-1.5 rounded-lg px-2.5 py-1.5 text-sm text-muted transition-colors hover:bg-accent-soft hover:text-accent"
              >
                <Icon name={s.icon} class="size-4" />
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <Dialog id="clickbait" label="Resume">
    <p class="text-lg leading-relaxed text-balance">You have been clickbaited into viewing my Resume</p>
    <p class="mt-4 text-sm text-muted">View Now →</p>
    <div class="mt-3 flex flex-wrap justify-center gap-2">
      {
        resumes.map((r) => (
          <a
            href={r.href}
            target="_blank"
            rel="noopener"
            class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-bg transition-opacity hover:opacity-90"
          >
            {r.label}
          </a>
        ))
      }
    </div>
  </Dialog>
</section>

