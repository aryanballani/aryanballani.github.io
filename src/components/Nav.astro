---
import { Icon } from 'astro-icon/components';
import ResumeMenu from './ResumeMenu.astro';
import logo from '../assets/nav-logo.svg';
import { nav, site, socials } from '../data/site';

const github = socials.find((s) => s.label === 'GitHub')!;
const trim = (path: string) => path.replace(/\/+$/, '') || '/';
const current = trim(Astro.url.pathname);
---

<header class="sticky top-0 z-40 border-b border-border/60 bg-bg/75 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-3xl items-center gap-2 px-5 sm:px-6" aria-label="Main">
    <a href="/" class="group mr-auto flex items-center gap-2.5" aria-label="Aryan Ballani, home">
      <img
        src={logo.src}
        alt=""
        width="36"
        height="36"
        class="size-9 transition-transform duration-300 group-hover:scale-110"
      />
      <span class="font-display text-[1.05rem] tracking-wide text-accent">{site.name}</span>
    </a>

    <ul class="hidden items-center md:flex">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={trim(item.href) === current ? 'page' : undefined}
              class="rounded-md px-3 py-1.5 text-sm text-muted transition-colors hover:text-text aria-[current=page]:text-accent"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={github.href}
      target="_blank"
      rel="noopener"
      class="grid size-9 place-items-center rounded-md text-muted transition-colors hover:text-text"
      aria-label="GitHub"
    >
      <Icon name={github.icon} class="size-[18px]" />
    </a>

    <ResumeMenu />

    <button
      type="button"
      data-cmdk-open
      class="ml-1 flex h-9 cursor-pointer items-center gap-1 rounded-md border border-border px-2.5 font-mono text-xs text-muted transition-colors hover:border-accent/50 hover:text-text"
      aria-label="Open command palette"
      aria-keyshortcuts="Meta+K Control+K"
    >
      <Icon name="lucide:command" class="size-3.5 md:hidden" />
      <kbd class="hidden md:inline">⌘K</kbd>
    </button>
  </nav>

  <!-- Small screens: page links get their own row under the bar -->
  <ul class="mx-auto flex max-w-3xl items-center gap-1 px-3 pb-2 md:hidden" aria-label="Pages">
    {
      nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={trim(item.href) === current ? 'page' : undefined}
            class="rounded-md px-2.5 py-1 text-sm text-muted transition-colors hover:text-text aria-[current=page]:bg-accent-soft aria-[current=page]:text-accent"
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>
