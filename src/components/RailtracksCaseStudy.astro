---
import { Icon } from 'astro-icon/components';
import { railtracks } from '../data/railtracks';
---

<article class="rounded-2xl border border-border bg-surface p-6 sm:p-8">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="text-xl font-semibold tracking-tight">
      <a href="https://github.com/RailtownAI/railtracks" target="_blank" rel="noopener" class="transition-colors hover:text-accent">
        Railtracks
      </a>
    </h3>
    <p class="font-mono text-xs text-accent">{railtracks.role}</p>
  </div>
  <p class="mt-3 max-w-2xl leading-relaxed text-muted">{railtracks.summary}</p>

  <dl class="mt-6 grid grid-cols-3 gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-6">
    {
      railtracks.stats.map((s) => (
        <div class="flex flex-col-reverse bg-surface px-3 py-3">
          <dt class="mt-0.5 text-[0.7rem] leading-tight text-muted">{s.label}</dt>
          <dd class="font-mono text-lg text-text tabular-nums">{s.value}</dd>
        </div>
      ))
    }
  </dl>
  <h4 class="mt-6 mb-2 font-mono text-xs tracking-wide text-muted">Pull requests I'm proud of</h4>
  <ul class="divide-y divide-border">
    {
      railtracks.prs.map((pr) => (
        <li>
          <a
            href={pr.href}
            target="_blank"
            rel="noopener"
            class="group grid grid-cols-[3.5rem_1fr_auto] items-baseline gap-x-3 py-2.5 text-sm"
          >
            <span class="font-mono text-xs text-accent tabular-nums">#{pr.number}</span>
            <span>
              <span class="transition-colors group-hover:text-accent">{pr.title}</span>
              <span class="block text-xs text-muted sm:inline sm:pl-2">{pr.detail}</span>
            </span>
            <Icon
              name="lucide:arrow-up-right"
              class="size-3.5 text-muted transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent"
            />
          </a>
        </li>
      ))
    }
  </ul>

  <ul class="mt-6 flex flex-wrap gap-2">
    {
      railtracks.links.map((l) => (
        <li>
          <a
            href={l.href}
            target="_blank"
            rel="noopener"
            class="flex items-center gap-1.5 rounded-lg border border-border px-3 py-1.5 text-sm text-muted transition-colors hover:border-accent/50 hover:text-accent"
          >
            <Icon name={l.icon} class="size-3.5" />
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</article>
