---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';
import { formatRange } from '../lib/format';

const roles = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
---

<section id="experience" aria-labelledby="experience-heading" class="py-16">
  <SectionHeading id="experience" title="XP++">
    <a
      href="https://www.linkedin.com/in/aryanballani/"
      target="_blank"
      rel="noopener"
      class="flex items-center gap-1 font-mono text-xs text-muted transition-colors hover:text-accent"
    >
      More on LinkedIn <Icon name="lucide:arrow-up-right" class="size-3.5" />
    </a>
  </SectionHeading>

  <ol class="space-y-10">
    {
      roles.map(({ data }) => (
        <li class="grid gap-1 sm:grid-cols-[9.5rem_1fr] sm:gap-6">
          <p class="pt-0.5 font-mono text-xs text-muted tabular-nums">{formatRange(data.start, data.end)}</p>
          <div>
            <h3 class="font-medium">
              {data.role}
              <span class="text-muted"> · </span>
              {data.url ? (
                <a href={data.url} target="_blank" rel="noopener" class="link-underline text-text">
                  {data.company}
                </a>
              ) : (
                data.company
              )}
            </h3>
            <p class="mt-0.5 text-sm text-muted">{data.location}</p>
            {data.highlights.length > 0 && (
              <ul class="mt-3 space-y-1.5 text-[0.94rem] leading-relaxed text-muted">
                {data.highlights.map((h) => (
                  <li class="relative pl-4 before:absolute before:top-[0.7em] before:left-0 before:size-1 before:rounded-full before:bg-accent/60">
                    {h}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>
